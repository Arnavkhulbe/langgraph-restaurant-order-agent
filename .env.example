# Copy this file to .env and fill in ONE provider key.
# If no key is set, the agent runs with a built-in offline order parser
# (deterministic, no network needed - good for the TC simulations).

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
